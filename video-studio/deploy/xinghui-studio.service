[Unit]
Description=Xinghui Video Studio Web and Director Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xinghui
Group=xinghui
WorkingDirectory=/opt/xinghui-video-studio/current/video-studio
EnvironmentFile=/opt/xinghui-video-studio/shared/.env
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
