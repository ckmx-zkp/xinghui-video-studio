# MiniMax Token Plan API（复制为 .env 后填入真实密钥；不要提交 .env）
MINIMAX_API_KEY=
MINIMAX_API_HOST=https://api.minimaxi.com
MINIMAX_TEXT_MODEL=MiniMax-M3

# 本地服务地址，可按需覆盖
STUDIO_PORT=4175
COMFY_URL=http://127.0.0.1:8188
# 可选：ffmpeg-static 不兼容时指定已验证的 ffmpeg.exe
FFMPEG_PATH=

# 无 GPU 时仅模拟本地视频生成；不会替代真实 M3 对话。
STUDIO_VIDEO_DEMO_MODE=0
# 仅用于离线 UI/流程测试。开启后导演回复是固定数据，不是 LLM 推理。
STUDIO_DIRECTOR_DEMO_MODE=0
